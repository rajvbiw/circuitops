# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secrets
JWT_SECRET=gada_electronics_super_secret_nostalgic_key_2026
JWT_EXPIRES_IN=7d

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=gada_electronics

# AI Provider Abstraction
# Options: mock, openai, claude, ollama
AI_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Cloudinary Integration (Optional: falls back to local placeholders if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Integration (Optional: sandbox mode works locally if empty)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
